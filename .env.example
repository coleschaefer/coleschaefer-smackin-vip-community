# Copy to .env.local. Never commit real values.
# Facebook password is not a setting. It stays in the password vault.

# Postgres connection for production and any shared environment.
# When unset, local dev uses an embedded Postgres (PGlite) in .data/pglite.
DATABASE_URL=

# xAI API key for Grok tool calling. The app runs the tool loop.
# Without this key, drafting falls back to the policy composer and says so.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai

# Buffer is the backup notification path only. schedulingType is forced to notification.
# Create the key in Buffer → Settings → API. Do not put it in the repo.
BUFFER_API_KEY=

# Required in any shared or production deployment. Leave empty only on a private local machine.
OPS_ACCESS_TOKEN=

# Set to true to refuse startup unless DATABASE_URL is a real Postgres URL.
REQUIRE_POSTGRES=false
